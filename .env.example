# Local development; the same ALPACA_KEY/ALPACA_SECRET names are used by CI.
ALPACA_KEY=
ALPACA_SECRET=

# Default sources are SIP / OPRA; never silently downgrade to IEX / indicative.
EQO_STOCK_FEED=sip
EQO_OPTION_FEED=opra
EQO_MARKET_DATA_BASE_URL=https://data.alpaca.markets
EQO_MARKET_STREAM_BASE_URL=wss://stream.data.alpaca.markets
EQO_STOCK_SYMBOLS=SPY,QQQ,IWM,NVDA,TSLA
EQO_MAX_OPTION_SUBSCRIPTIONS=500

# Loopback-only by default. Non-loopback bind requires EQO_ACCESS_TOKEN.
EQO_BIND=127.0.0.1:8080
EQO_ACCESS_TOKEN=

# Optional OpenBB/OpenBQ/FINOS-compatible Workspace origin.
# HTTPS or loopback HTTP only; wildcard is rejected.
EQO_OPENBB_ALLOWED_ORIGIN=http://127.0.0.1:3000

# External Rust broker services; not the Alpaca market-data endpoint.
# Each service implements docs/ADAPTER_CONTRACT.md.
EQO_ADAPTER_ALPACA_URL=
EQO_ADAPTER_ALPACA_TOKEN=
EQO_ADAPTER_IBKR_URL=
EQO_ADAPTER_IBKR_TOKEN=
EQO_ADAPTER_SCHWAB_URL=
EQO_ADAPTER_SCHWAB_TOKEN=

# Fail-closed: disabled by default, only Paper orders supported in this phase.
EQO_EXECUTION_MODE=disabled
EQO_MAX_ORDER_QTY=10
EQO_MAX_ORDER_NOTIONAL=1000
EQO_AUDIT_PATH=./audit/order-events.jsonl
EQO_WEB_DIST=./apps/gateway/empty
