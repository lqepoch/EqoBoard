# Optional server-only market credentials. Pull request CI never reads real keys.
ALPACA_KEY=
ALPACA_SECRET=

# Default sources are SIP / OPRA; never silently downgrade to IEX / indicative.
EQO_STOCK_FEED=sip
EQO_OPTION_FEED=opra
EQO_MARKET_DATA_BASE_URL=https://data.alpaca.markets
EQO_MARKET_STREAM_BASE_URL=wss://stream.data.alpaca.markets
EQO_STOCK_SYMBOLS=SPY,QQQ,IWM,NVDA,TSLA
EQO_MAX_STOCK_SUBSCRIPTIONS=100
EQO_MAX_OPTION_SUBSCRIPTIONS=500

# Gateway validates signed, short-lived subject tokens. Generate independent keys
# with `openssl rand -hex 32`; EQO_GATEWAY_JWT_SECRET belongs only to Next + Rust,
# while EQO_RESEARCH_JWT_SECRET is shared by Next + research + Rust.
EQO_BIND=127.0.0.1:8080
EQO_GATEWAY_HOST_PORT=8080
EQO_TERMINAL_HOST_PORT=3000
EQO_GATEWAY_JWT_SECRET=
EQO_RESEARCH_JWT_SECRET=

# Optional server-only MDP read API. Empty EQO_MDP_URL leaves the BFF proxy disabled.
# Plain HTTP is accepted only for loopback development or the private Docker DNS
# name `market-data-platform`; use HTTPS for every other configured origin.
EQO_MDP_URL=
# Generate two independent values with `openssl rand -hex 32`. These are not
# Gateway/NextAuth keys: terminal receives only MDP_TERMINAL_JWT_SECRET and the
# isolated research BFF receives only MDP_RESEARCH_JWT_SECRET.
MDP_TERMINAL_JWT_SECRET=
MDP_RESEARCH_JWT_SECRET=

# Optional private registered-prediction read API. Empty URL leaves its BFF disabled.
# The service origin is HTTPS, exact loopback for local use, or private Compose DNS
# `quant-research`; it is never exposed to the browser. Each runtime receives only
# its own Quant delegation key, separate from all OIDC, NextAuth, Gateway, and MDP keys.
EQO_QUANT_RESEARCH_URL=
QUANT_TERMINAL_JWT_SECRET=
QUANT_RESEARCH_JWT_SECRET=

# Optional, terminal-only offline preview of the trading-engine read API.
# Engine binds to loopback; the BFF must share its host/network namespace.
# The terminal key must match the engine's owner-only delegation key file and
# must differ from every Gateway, NextAuth, MDP, Quant, provider, and OIDC client secret.
EQO_ENGINE_URL=
ENGINE_TERMINAL_JWT_SECRET=

# OpenTerminal BFF identity configuration. Use a trusted OIDC issuer (HTTPS, or
# HTTP loopback for local development) with a client allowed to return to this URL.
EQO_PUBLIC_ORIGIN=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Optional native OpenBB Lite profile navigation. When set, use an exact HTTPS
# origin (or exact loopback HTTP origin locally) with a different hostname
# from EQO_PUBLIC_ORIGIN. The browser link stays hidden while this is empty.
EQO_RESEARCH_PUBLIC_ORIGIN=
EQO_OPENBB_HOST_PORT=8088
EQO_OPENBB_NEXTAUTH_SECRET=
EQO_OPENBB_SESSION_TTL_SECONDS=3600
EQO_OPENBB_OIDC_ISSUER=
EQO_OPENBB_OIDC_CLIENT_ID=
EQO_OPENBB_OIDC_CLIENT_SECRET=
OPENBB_ADMIN_EMAIL=
OPENBB_ADMIN_PASSWORD=
# Optional release-only override; use tools/openbb/openbb-release-compose.sh up
# with a reviewed repository@sha256 digest, never a mutable tag.
EQO_OPENBB_LITE_RELEASE_IMAGE=
# Required only when EQO_BFF_MODE=research; use a different hostname than the terminal.
EQO_TERMINAL_PUBLIC_ORIGIN=
NEXTAUTH_SECRET=
EQO_SESSION_TTL_SECONDS=3600
EQO_OIDC_ISSUER=
EQO_OIDC_CLIENT_ID=
EQO_OIDC_CLIENT_SECRET=

# Private Next -> Node service authentication. Never expose in browser variables.
EQO_RESEARCH_API_KEY=
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000

# Optional OpenBB/OpenBQ/FINOS-compatible Workspace origin.
# HTTPS or loopback HTTP only; wildcard is rejected.
EQO_OPENBB_ALLOWED_ORIGIN=

# External Rust broker services; not the Alpaca market-data endpoint.
# Each service implements docs/ADAPTER_CONTRACT.md.
EQO_ADAPTER_ALPACA_URL=
EQO_ADAPTER_ALPACA_TOKEN=
EQO_ADAPTER_IBKR_URL=
EQO_ADAPTER_IBKR_TOKEN=
EQO_ADAPTER_SCHWAB_URL=
EQO_ADAPTER_SCHWAB_TOKEN=

# Paper/Live requests are reported for diagnostics only; effective execution is always disabled.
EQO_EXECUTION_MODE=disabled
EQO_MAX_ORDER_QTY=10
EQO_MAX_ORDER_NOTIONAL=1000
EQO_AUDIT_PATH=./audit/order-events.jsonl
EQO_WEB_DIST=./apps/gateway/empty
