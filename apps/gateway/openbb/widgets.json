{
  "eqo_sip_watchlist": {
    "name": "EqoBoard SIP Stock Quotes",
    "description": "US equity SIP snapshots through the EqoBoard Gateway. HTTP polling every 5 seconds; this table is not a Live Grid. Source identity, field-specific market times, feed, and snapshot completeness are returned per row. SIP denial remains an explicit error.",
    "endpoint": "openbb/v1/stocks",
    "category": "EqoBoard",
    "subCategory": "Stocks",
    "type": "table",
    "exportable": false,
    "gridData": {
      "w": 20,
      "h": 9
    },
    "params": [
      {
        "paramName": "symbols",
        "type": "text",
        "label": "Stocks",
        "value": "QQQ,SPY,NVDA",
        "description": "Comma-separated US tickers (max 50)",
        "show": true
      }
    ],
    "data": {
      "table": {
        "columnsDefs": [
          {
            "field": "symbol",
            "headerName": "Symbol"
          },
          {
            "field": "last",
            "headerName": "Last",
            "cellDataType": "number"
          },
          {
            "field": "bid",
            "headerName": "Bid",
            "cellDataType": "number"
          },
          {
            "field": "ask",
            "headerName": "Ask",
            "cellDataType": "number"
          },
          {
            "field": "change_percent",
            "headerName": "Change %",
            "cellDataType": "number"
          },
          {
            "field": "volume",
            "headerName": "Volume",
            "cellDataType": "number"
          },
          {
            "field": "market_as_of",
            "headerName": "Last as of"
          },
          {
            "field": "last_basis",
            "headerName": "Last basis"
          },
          {
            "field": "trade_at",
            "headerName": "Trade as of"
          },
          {
            "field": "quote_at",
            "headerName": "Quote as of"
          },
          {
            "field": "source_label",
            "headerName": "Source"
          },
          {
            "field": "feed",
            "headerName": "Feed"
          },
          {
            "field": "complete",
            "headerName": "Complete",
            "cellDataType": "boolean"
          },
          {
            "field": "pages_fetched",
            "headerName": "Pages fetched",
            "cellDataType": "number"
          },
          {
            "field": "has_more",
            "headerName": "More pages",
            "cellDataType": "boolean"
          },
          {
            "field": "truncated",
            "headerName": "Truncated",
            "cellDataType": "boolean"
          }
        ]
      },
      "dataKey": "eqoSipStocks"
    },
    "source": ["EqoBoard Rust Gateway"],
    "refetchInterval": 5000,
    "staleTime": 1000
  },
