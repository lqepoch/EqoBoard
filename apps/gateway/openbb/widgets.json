{
  "eqo_sip_watchlist": {
    "name": "EqoBoard SIP Stock Quotes",
    "description": "US equities SIP quote snapshots from Alpaca Plus; source and as-of timestamp preserved. Fails explicitly if SIP access is unavailable.",
    "endpoint": "openbb/v1/stocks",
    "category": "EqoBoard",
    "subCategory": "Stocks",
    "type": "table",
    "exportable": false,
    "gridData": {
      "w": 20,
      "h": 9
    },
    "params": [
      {
        "paramName": "symbols",
        "type": "text",
        "label": "Stocks",
        "value": "QQQ,SPY,NVDA",
        "description": "Comma-separated US tickers (max 50)",
        "show": true
      }
    ],
    "data": {
      "table": {
        "columnsDefs": [
          {
            "field": "symbol",
            "headerName": "Symbol"
          },
          {
            "field": "last",
            "headerName": "Last",
            "cellDataType": "number"
          },
          {
            "field": "bid",
            "headerName": "Bid",
            "cellDataType": "number"
          },
          {
            "field": "ask",
            "headerName": "Ask",
            "cellDataType": "number"
          },
          {
            "field": "change_percent",
            "headerName": "Change %",
            "cellDataType": "number"
          },
          {
            "field": "volume",
            "headerName": "Volume",
            "cellDataType": "number"
          },
          {
            "field": "updated_at",
            "headerName": "As of"
          },
          {
            "field": "feed",
            "headerName": "Feed"
          }
        ]
      },
      "dataKey": "eqoSipStocks"
    },
    "source": [
      "Alpaca SIP"
    ],
    "refetchInterval": 5000,
    "staleTime": 1000
  },
