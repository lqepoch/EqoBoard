{
  "name": "openterminal",
  "private": true,
  "workspaces": ["server", "web"],
  "overrides": {
    "postcss": "8.5.28",
    "proxy-addr": "2.0.8",
    "qs": "^6.16.0",
    "sharp": "0.35.5",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "vite": "6.4.3"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "concurrently -n api,web \"npm run start -w server\" \"npm run start -w web\"",
    "test": "npm run test -w server",
    "test:e2e:openbb": "playwright test -c web/playwright.openbb.config.ts",
    "test:e2e:openbb:recovery": "OPENBB_E2E_RECOVERY_ONLY=1 playwright test -c web/playwright.openbb.config.ts",
    "lint": "npm run lint -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
