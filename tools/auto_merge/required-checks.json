{
  "schema_version": 3,
  "ci_workflow_file": ".github/workflows/ci.yml",
  "ci_workflow_name": "EqoBoard CI",
  "additional_workflows": [
    {
      "key": "openbb",
      "workflow_file": ".github/workflows/openbb.yml",
      "workflow_name": "OpenBB Optional CI"
    },
    {
      "key": "native",
      "workflow_file": ".github/workflows/native-web.yml",
      "workflow_name": "Native Web CI"
    }
  ],
  "required_checks": [
    {
      "context": "Rust data / gateway / execution",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true
    },
    {
      "context": "Offline market-data contract tests",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true
    },
    {
      "context": "OpenTerminal / AG Grid / Next.js",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true
    },
    {
      "context": "OpenBB optional validation gate",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true,
      "workflow_key": "openbb"
    },
    {
      "context": "Native web validation gate",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true,
      "workflow_key": "native"
    }
  ],
  "guard_checks": [
    {
      "context": "CodeQL",
      "app_slug": "github-advanced-security"
    },
    {
      "context": "Analyze (rust)",
      "app_slug": "github-actions"
    },
    {
      "context": "Analyze (actions)",
      "app_slug": "github-actions"
    },
    {
      "context": "Analyze (python)",
      "app_slug": "github-actions"
    },
    {
      "context": "Analyze (javascript-typescript)",
      "app_slug": "github-actions"
    },
    {
      "context": "OpenBB change routing",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true,
      "workflow_key": "openbb",
      "must_exist": true
    },
    {
      "context": "OpenBB source supply chain",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true,
      "workflow_key": "openbb",
      "allow_skipped": true,
      "must_exist": true
    },
    {
      "context": "OpenBB native runtime E2E",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true,
      "workflow_key": "openbb",
      "allow_skipped": true,
      "must_exist": true
    },
    {
      "context": "Native web lock bootstrap",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true,
      "workflow_key": "native",
      "must_exist": true
    },
    {
      "context": "Native web package and runtime checks",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true,
      "workflow_key": "native",
      "must_exist": true
    },
    {
      "context": "Native Windows runtime and local launch",
      "app_slug": "github-actions",
      "bind_to_workflow_run": true,
      "workflow_key": "native",
      "must_exist": true
    }
  ]
}
