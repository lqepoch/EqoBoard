+"""SQL expressions shared by backend queries that target multiple dialects."""
+
+from sqlalchemy import literal
+from sqlalchemy.sql.elements import ColumnElement
+
+
+def user_display_name(
+    first_name: ColumnElement[str], last_name: ColumnElement[str]
+) -> ColumnElement[str]:
+    """Concatenate non-null user name columns using dialect-native syntax."""
+    return first_name + literal(" ") + last_name
