+const COMMUNITY_ONLY_UNSUPPORTED_GRID_OPTIONS = new Set([
+  "cellSelection",
+  "createChartContainer",
+  "customChartThemes",
+  "enableAdvancedFilter",
+  "enableCharts",
+  "enableFillHandle",
+  "enableRangeSelection",
+  "getChartMenuItems",
