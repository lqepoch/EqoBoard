+  "pivotMode",
+  "pivotPanelShow",
+  "postProcessPopup",
+  "rowGroupPanelShow",
+  "sideBar",
+  "statusBar",
+]);
+
+const COMMUNITY_ONLY_UNSUPPORTED_COLUMN_OPTIONS = new Set([
+  "aggFunc",
+  "allowedAggFuncs",
+  "chartDataType",
+  "enablePivot",
+  "enableRowGroup",
+  "enableValue",
+  "pivot",
+  "pivotIndex",
+  "rowGroup",
+  "rowGroupIndex",
+]);
+
+function stripCommunityUnsupportedColumnOptions<T>(value: T): T {
+  if (Array.isArray(value)) {
+    return value.map(stripCommunityUnsupportedColumnOptions) as T;
+  }
+  if (!value || typeof value !== "object") return value;
+
+  const column = { ...(value as Record<string, unknown>) };
+  for (const key of COMMUNITY_ONLY_UNSUPPORTED_COLUMN_OPTIONS) delete column[key];
+  if (typeof column.filter === "string" && /^(agSetColumnFilter|agMultiColumnFilter|agGroupColumnFilter)$/.test(column.filter)) {
+    column.filter = true;
+  }
+  if (column.children) {
+    column.children = stripCommunityUnsupportedColumnOptions(column.children);
+  }
+  return column as T;
+}
+
+function stripCommunityUnsupportedGridOptions<T>(value: T): T {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return value;
+
+  const options = { ...(value as Record<string, unknown>) };
+  for (const key of COMMUNITY_ONLY_UNSUPPORTED_GRID_OPTIONS) delete options[key];
+  if (options.rowModelType === "serverSide") {
+    throw new Error("AG Grid Server Side Row Model is unavailable in OpenBB Workspace Lite Community.");
+  }
+  if (options.defaultColDef) {
+    options.defaultColDef = stripCommunityUnsupportedColumnOptions(options.defaultColDef);
+  }
+  if (options.columnDefs) {
+    options.columnDefs = stripCommunityUnsupportedColumnOptions(options.columnDefs);
+  }
+  return options as T;
+}
+
+/** Remove Enterprise-only options while retaining Community sorting, filtering, and row rendering. */
+export function adaptCommunityGridProps<T extends Record<string, unknown>>(props: T): T {
+  const options = stripCommunityUnsupportedGridOptions(props) as Record<string, unknown>;
+  const gridOptions = options.gridOptions;
+  if (gridOptions && typeof gridOptions === "object") {
+    options.gridOptions = stripCommunityUnsupportedGridOptions(gridOptions);
+  }
+  return options as T;
+}
